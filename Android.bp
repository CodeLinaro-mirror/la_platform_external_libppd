cc_library_shared {
    name: "libppd",

    sdk_version: "current",
    visibility: [
        "//vendor:__subpackages__",
        "//external/epson-inkjet-printer-escpr",
    ],

    cflags: [
        "-DHAVE_LIBCUPS2",
        "-Wno-implicit-fallthrough",
        "-Wno-ignored-qualifiers",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
        "-Wno-tautological-bitwise-compare",
    ],

    // Put the config.h file in a private dir so it doesn't get exported.
    local_include_dirs: [
        "private",
    ],

    srcs: [
        "ppd/*.c",
    ],

    exclude_srcs: [
        "ppd/testppd.c",
        "ppd/testdriver.c",
        "ppd/testppdfile.c",
    ],

    export_include_dirs: [
        ".",
        "ppd",
    ],

    shared_libs: [
        "libcups",
        "libcupsfilters",
        "libjpeg",
        "libz",
    ],
}

rust_bindgen {
    name: "libppd_bindgen",
    crate_name: "ppd_bindgen",

    wrapper_src: "ppd/ppd.h",

    source_stem: "bindings",
    shared_libs: [
        "libppd",
        "libcups",
        "libcupsfilters",
    ],

    visibility: [
        "//vendor:__subpackages__",
    ],
}
